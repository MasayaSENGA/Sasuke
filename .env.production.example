# 本番 (Lightsail) 用の環境変数。サーバー上で .env.production にコピーして値を設定する
# DATABASE_URL は compose.yaml で設定するため不要

# 公開するドメイン (DNS の A レコードを Lightsail の静的 IP に向けておく)
DOMAIN="home.example.com"

# アプリの公開 URL (https://{DOMAIN})
BETTER_AUTH_URL="https://home.example.com"

# openssl rand -base64 32 で生成。開発環境とは別の値にすること
BETTER_AUTH_SECRET=""

# openssl rand -base64 32 で生成。変更すると保存済みの SwitchBot トークンを復号できなくなるので注意
ENCRYPTION_KEY=""

# 新規アカウント作成を許可するか。最初の自分のアカウントを作ったら false に戻す
ALLOW_SIGNUP="false"
