# 本番用の環境変数。サーバー上で .env.production にコピーして値を設定する
# DATABASE_URL は compose.yaml / compose.tunnel.yaml で設定するため不要

# [Lightsail + Caddy の場合] 公開するドメイン (DNS の A レコードを Lightsail の静的 IP に向けておく)
DOMAIN="home.example.com"

# [自宅 Windows + Cloudflare Tunnel の場合] Cloudflare のダッシュボードでトンネル作成時に表示されるトークン
# TUNNEL_TOKEN=""

# アプリの公開 URL (https://{DOMAIN})
BETTER_AUTH_URL="https://home.example.com"

# openssl rand -base64 32 で生成。開発環境とは別の値にすること
BETTER_AUTH_SECRET=""

# openssl rand -base64 32 で生成。変更すると保存済みの SwitchBot トークンを復号できなくなるので注意
ENCRYPTION_KEY=""

# 新規アカウント作成を許可するか。最初の自分のアカウントを作ったら false に戻す
ALLOW_SIGNUP="false"

# 温湿度の履歴を記録する間隔 (分)。既定 10。0 で定期記録を無効化
# HISTORY_COLLECT_INTERVAL_MINUTES="10"
