# SQLite のファイルパス (prisma/schema.prisma からの相対ではなく、プロジェクトルートからの相対)
DATABASE_URL="file:./dev.db"

# Better Auth: セッション署名用のシークレット (openssl rand -base64 32 で生成)
BETTER_AUTH_SECRET=""
# アプリの公開 URL
BETTER_AUTH_URL="http://localhost:3000"

# SwitchBot トークン/シークレットを DB 保存時に暗号化する鍵 (openssl rand -base64 32 で生成)
ENCRYPTION_KEY=""
