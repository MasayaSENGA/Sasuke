# SQLite のファイルパス (prisma/schema.prisma からの相対ではなく、プロジェクトルートからの相対)
DATABASE_URL="file:./dev.db"

# Better Auth: セッション署名用のシークレット (openssl rand -base64 32 で生成)
BETTER_AUTH_SECRET=""
# アプリの公開 URL
BETTER_AUTH_URL="http://localhost:3000"

# SwitchBot トークン/シークレットを DB 保存時に暗号化する鍵 (openssl rand -base64 32 で生成)
ENCRYPTION_KEY=""

# 開発用: true にすると架空のデバイスでダッシュボードを確認できる (本番ビルドでは常に無効)
SWITCHBOT_MOCK="false"

# 新規アカウント作成を許可するか (未設定時: 開発では許可、本番では禁止)
# ALLOW_SIGNUP="true"
