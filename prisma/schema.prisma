// Prisma schema
// 認証系テーブル (User / Session / Account / Verification / Passkey) は Better Auth のスキーマに準拠。

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  passkeys      Passkey[]

  switchBotCredential SwitchBotCredential?
  devicePreferences   DevicePreference[]
  remoteStates        RemoteState[]
  sensorReadings      SensorReading[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// パスキー (WebAuthn の公開鍵)。Better Auth の passkey プラグインのスキーマに準拠
model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

// ユーザーごとの SwitchBot API 認証情報 (トークン/シークレットは AES-256-GCM で暗号化して保存)
model SwitchBotCredential {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  encryptedToken    String
  encryptedSecret   String
  /// Webhook URL に含める秘密文字列の SHA-256 (受信時にユーザーを特定する)。null なら Webhook 無効
  webhookSecretHash String?   @unique
  webhookEnabledAt  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("switchbot_credential")
}

// ダッシュボードのタイルの並び順・表示設定 (ユーザー × デバイスごと)
model DevicePreference {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId  String
  sortOrder Int      @default(0)
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, deviceId])
  @@map("device_preference")
}

// 赤外線リモコンでこのアプリから最後に送った設定 (状態を取得できないため、全端末で共有できるようサーバーに保存する)
model RemoteState {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId    String
  /// "on" / "off"
  power       String?
  /// エアコンのみ: 設定温度 (℃)
  temperature Int?
  /// エアコンのみ: 1 自動 / 2 冷房 / 3 除湿 / 4 送風 / 5 暖房
  mode        Int?
  /// エアコンのみ: 1 自動 / 2 弱 / 3 中 / 4 強
  fanSpeed    Int?
  updatedAt   DateTime @updatedAt

  @@unique([userId, deviceId])
  @@map("remote_state")
}

// 温湿度計の記録 (履歴グラフ用)
model SensorReading {
  id          Int      @id @default(autoincrement())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId    String
  temperature Float?
  humidity    Float?
  co2         Int?
  recordedAt  DateTime @default(now())

  @@index([userId, deviceId, recordedAt])
  @@index([recordedAt])
  @@map("sensor_reading")
}
